#!/usr/bin/env bash
set -euo pipefail

# Land the current worktree's branch on main, without a merge commit: rebase it
# onto main, then fast-forward main in the root worktree, where it's checked
# out, and delete the branch.
#
# On conflicts, the rebase stops here and main is left untouched.

branch=$(git branch --show-current)
if [[ -z "$branch" ]]; then
  echo "Not on a branch" >&2
  exit 1
fi

if [[ "$branch" == "main" ]]; then
  echo "Already on main" >&2
  exit 1
fi

# The root worktree is the one that holds the shared .git directory.
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

# When run from a linked worktree, git may export GIT_DIR pointing at this
# worktree, which would override `-C` and make the merge a no-op.
in_root() { env -u GIT_DIR git -C "$root" "$@"; }

if [[ "$(git rev-parse --path-format=absolute --show-toplevel)" == "$root" ]]; then
  # The branch is checked out in the root worktree itself: switch it to main
  # after the rebase, rather than detaching.
  git rebase main
  git switch main
else
  root_branch=$(in_root branch --show-current)
  if [[ "$root_branch" != "main" ]]; then
    echo "Root worktree ($root) is on '${root_branch:-detached HEAD}', not main" >&2
    exit 1
  fi
  git rebase main
  git switch --detach main
fi

in_root merge --ff-only "$branch"
in_root push origin main

git branch -D "$branch"
