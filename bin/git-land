#!/usr/bin/env bash
set -euo pipefail

# Land the current worktree's branch on main, without a merge commit: rebase it
# onto main, then fast-forward main in the root worktree and delete the branch.
#
# From a linked worktree, main must be checked out in the root, and this
# worktree is left detached on main. From the root itself, this switches to
# main.
#
# On conflicts, the rebase stops here and main is left untouched.

branch=$(git branch --show-current)
if [[ -z "$branch" ]]; then
  echo "Not on a branch" >&2
  exit 1
fi

if [[ "$branch" == "main" ]]; then
  echo "Already on main" >&2
  exit 1
fi

# The root worktree is the one that holds the shared .git directory.
root=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

is_root=false
if [[ "$(git rev-parse --path-format=absolute --show-toplevel)" == "$root" ]]; then
  is_root=true
fi

# When run from a linked worktree, git may export GIT_DIR pointing at this
# worktree, which would override `-C` and make the merge a no-op.
root_git() { env -u GIT_DIR git -C "$root" "$@"; }

assert_root_on_main() {
  local root_branch
  root_branch=$(root_git branch --show-current)
  if [[ "$root_branch" != "main" ]]; then
    echo "Root worktree ($root) is on '${root_branch:-detached HEAD}', not main" >&2
    exit 1
  fi
}

# Run git in the root worktree, which must be on main.
in_root() {
  assert_root_on_main
  root_git "$@"
}

# Check before rebasing, so a failure leaves everything untouched.
if ! $is_root; then
  assert_root_on_main
fi

git rebase main

if $is_root; then
  git switch main
  git merge --ff-only "$branch"
else
  in_root merge --ff-only "$branch"
  # Leave a linked worktree detached on the updated main.
  git switch --detach main
fi

in_root push origin main

git branch -D "$branch"
