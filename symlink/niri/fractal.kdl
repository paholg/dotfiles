output "DP-2" {
    position x=0 y=0
    scale 1.3
    transform "90"
}
output "DP-1" {
    // Use a non-tv mode to prevent limited color range.
    mode "3840x2160@119.999"
}
output "HDMI-A-1" {
    off
    mode "3840x2160@120"
    scale 2.0
}
spawn-at-startup "firefox"
spawn-at-startup "discord"
spawn-at-startup "steam"
workspace "steam" {
    open-on-output "DP-1"
}
workspace "main" {
    open-on-output "DP-1"
}
workspace "chat" {
    open-on-output "DP-2"
}
window-rule {
    // Float gam
    match title="client"
    open-floating true
}
