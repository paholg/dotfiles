output "DP-2" {
    off
    position x=0 y=0
    scale 1.2
    transform "90"
}
output "DP-1" {
    off
    // Use a non-tv mode to prevent limited color range.
    mode "3840x2160@119.999"
}
output "HDMI-A-1" {
    mode "3840x2160@120"
    scale 2.0
}
spawn-at-startup "steam"
window-rule {
    open-maximized true
}
binds {
    // Override to disable the locker for guest.
    Super+Ctrl+N {

    }
}
